# Supabase (Project Settings > API)
# La publishable key es pública por diseño: va en el bundle del navegador.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opcional: origen público para el QR cuando el host corre en localhost
# (por ejemplo http://192.168.1.20:4321).
PUBLIC_PLAY_ORIGIN=

# Opcional: URL del juego BreachParty para el selector de la landing.
PUBLIC_BREACHPARTY_URL=
